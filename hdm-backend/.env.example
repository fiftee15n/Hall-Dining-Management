# Environment Variables
PROJECT_NAME="Hall Dining Management API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite default; can be changed to PostgreSQL)
# Example PostgreSQL: DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/hdm_db"
DATABASE_URL="sqlite:///./data/hdm.db"

# Security & JWT
SECRET_KEY="supersecret_hall_dining_management_jwt_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (comma-separated or wildcard)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,*"
